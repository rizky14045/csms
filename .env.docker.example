# Konfigurasi jika menggunakan PostgreSQL Docker saat di laptop Anda sudah ada PostgreSQL:
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=sidak
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Catatan:
# - Port 5433 digunakan dari komputer host (DBeaver/TablePlus) agar TIDAK bentrok dengan PostgreSQL lokal laptop (yang memakai port 5432).
# - Di dalam container docker (app): sudah otomatis menggunakan DB_HOST=db dan port 5432 melalui docker-compose.yml.
